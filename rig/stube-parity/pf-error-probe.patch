+		if (cmdline_find_option("pferr", buf, sizeof(buf)) > 0) {
+			code = simple_strtoull(buf, NULL, 10);
+			asm volatile("mov %0, %%cr2" : : "r" (cr2v));
+			asm volatile("pushq $0x4000000\n\tpushq %0\n\tjmp boot_page_fault" : : "r" (code));
+		}
+	}
 
