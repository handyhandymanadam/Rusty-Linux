 	boot_params_ptr->acpi_rsdp_addr = get_rsdp_addr();
 
 	debug_putstr("early console in extract_kernel\n");
+	/* STUBE-PROBE-PFERR (scratch, never committed): feed boot_page_fault a hand-made frame with the error code
+	 * (and CR2) given on the command line (pferr=<code> pfcr2=<addr>, decimal) so do_boot_page_fault()'s
+	 * "Unexpected page-fault" error path runs and its serial output can be compared C stub vs Rust stub. */
+	{
+		extern int cmdline_find_option(const char *option, char *buffer, int bufsize);
+		char buf[24];
+		unsigned long code, cr2v = 0x1234567890UL;
